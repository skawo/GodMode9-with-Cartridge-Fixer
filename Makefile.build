
LIBS ?= 

OBJECTS := $(patsubst $(SOURCE)/%.s, $(BUILD)/%.o, \
          $(patsubst $(SOURCE)/%.c, $(BUILD)/%.o, \
          $(call rwildcard, $(SOURCE), *.s *.c)))

OBJECTS_COMMON := $(patsubst $(COMMON_DIR)/%.c, $(BUILD)/%.cmn.o, \
				$(call rwildcard, $(COMMON_DIR), *.c))

.PHONY: all
all: $(TARGET).elf

.PHONY: clean
clean:
	@rm -rf $(BUILD) $(TARGET).elf $(TARGET).dis $(TARGET).map $(CLEAN_EXTRA) $(FLAVORSTAMP)

# Flavor stamp: make does not track CFLAGS, and the linked/intermediate ELFs are
# shared between build flavors. This stamp is rewritten whenever the flavor flag
# (FIXER_SIM) changes, forcing a relink so a SIM ELF can never be reused by a
# normal build (or vice versa).
FLAVORSTAMP := .flavor
.PHONY: .FORCE
.FORCE:

$(FLAVORSTAMP): .FORCE
	@printf '%s' "$(FIXER_SIM)" | cmp -s - $@ || printf '%s' "$(FIXER_SIM)" > $@

$(TARGET).elf: $(OBJECTS) $(OBJECTS_COMMON) $(FLAVORSTAMP)
	@mkdir -p "$(@D)"
	@$(CC) $(LDFLAGS) $(OBJECTS) $(OBJECTS_COMMON) -o $@ $(LIBS)
	@$(OBJDUMP) -S -h $@ > $@.dis

$(BUILD)/%.cmn.o: $(COMMON_DIR)/%.c
	@mkdir -p "$(@D)"
	@echo "[$(PROCESSOR)] $<"
	@$(CC) -c $(CFLAGS) -o $@ $<

$(BUILD)/%.o: $(SOURCE)/%.c
	@mkdir -p "$(@D)"
	@echo "[$(PROCESSOR)] $<"
	@$(CC) -c $(CFLAGS) -o $@ $<

$(BUILD)/%.o: $(SOURCE)/%.s
	@mkdir -p "$(@D)"
	@echo "[$(PROCESSOR)] $<"
	@$(CC) -c $(ASFLAGS) -o $@ $<

include $(call rwildcard, $(BUILD)/, *.d)
